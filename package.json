{
  "name": "sotto",
  "productName": "Sotto",
  "version": "0.1.0",
  "private": true,
  "description": "A personal always-on-top AI overlay: screenshots, live transcription and chat, driven by global hotkeys.",
  "author": "Murilo Reis",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js",
    "dist:mac": "electron-vite build && node scripts/koffi-prebuilds.mjs && electron-builder --mac --config electron-builder.config.mjs",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.mjs",
    "release:sums": "node scripts/release-checksums.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "koffi": "^3.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
